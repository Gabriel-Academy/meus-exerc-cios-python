        "soma = 0\n",
        "cont = 0\n",
        "for c in range(1, 7):\n",
        "  n = int(input(f'Digite o {c}° número inteiro: '))\n",
        "  if n % 2 == 0:\n",
        "    soma = soma + n\n",
        "    cont = cont + 1\n",
        "print(f'Você informou {cont} números e a soma é igual a: {soma}')"
